# CodeRed NDR — Suricata threshold / suppression tuning
# Loaded via `threshold-file` in codered-override.yaml.
# Docs: https://docs.suricata.io/en/latest/configuration/global-thresholds.html
#
# Data-driven from observed alert volume on this sensor. Two levers:
#   threshold ... type limit  -> rate-limit (keep N per window); retains visibility
#   suppress ...              -> drop entirely; use only for zero-value noise
# Add your own lines below; reload with: sudo /opt/codered/bin/update-rules.sh
# (or `kill -USR2 $(cat /var/run/suricata.pid)`).

# --- Decoder noise: non-IP L2 frames on the SPAN (LLDP/STP/ARP-ish). No
#     security value on a passive monitor port -> suppress.
suppress gen_id 1, sig_id 2200121

# --- STUN binding requests (WebRTC / VPN / P2P; observed egress to UDP/51820).
#     High volume, low value -> keep 1 alert per source per 10 min.
threshold gen_id 1, sig_id 2033078, type limit, track by_src, count 1, seconds 600
threshold gen_id 1, sig_id 2016149, type limit, track by_src, count 1, seconds 600
threshold gen_id 1, sig_id 2016150, type limit, track by_src, count 1, seconds 600

# ============================================================================
# Extended tuning — 2026-06-04 (data-driven from ~13.5h steady-state traffic,
# 7,501 alerts post-startup). All new entries are rate-limits, not suppressions:
# keep 1 alert per source per 10 min so a breadcrumb survives for hunting while
# the flood is cut. NOTE: Suricata's threshold parser rejects trailing inline
# comments on a rule line, so each sig's meaning is noted on the line above it.
# Reload after editing: sudo /opt/codered/bin/update-rules.sh
# ----------------------------------------------------------------------------

# --- Suricata STREAM / TCP-reassembly anomalies (Generic Protocol Command
#     Decode). On this SINGLE-NIC SPAN the tap sees asymmetric / partially-
#     mirrored flows, so the stream engine emits these in bulk. No security
#     value here -> rate-limit hard (top 2 were one host: 2674 + 1749 hits).
# 2210008 STREAM 3whs SYN resend different seq
threshold gen_id 1, sig_id 2210008, type limit, track by_src, count 1, seconds 600
# 2210004 STREAM 3whs SYNACK resend different ack
threshold gen_id 1, sig_id 2210004, type limit, track by_src, count 1, seconds 600
# 2210016 STREAM CLOSEWAIT FIN out of window
threshold gen_id 1, sig_id 2210016, type limit, track by_src, count 1, seconds 600
# 2210044 STREAM packet with invalid timestamp
threshold gen_id 1, sig_id 2210044, type limit, track by_src, count 1, seconds 600
# 2210045 STREAM packet with invalid ack
threshold gen_id 1, sig_id 2210045, type limit, track by_src, count 1, seconds 600
# 2210046 STREAM SHUTDOWN RST invalid ack
threshold gen_id 1, sig_id 2210046, type limit, track by_src, count 1, seconds 600
# 2210010 STREAM 3whs wrong seq wrong ack
threshold gen_id 1, sig_id 2210010, type limit, track by_src, count 1, seconds 600
# 2230002 TLS invalid record type
threshold gen_id 1, sig_id 2230002, type limit, track by_src, count 1, seconds 600

# --- App-layer protocol-decode anomalies (header repetition, proto mismatch,
#     unmatched response). Decoder artifacts of malformed/odd traffic, not
#     threats on their own -> rate-limit.
# 2221036 HTTP response excessive header repetition
threshold gen_id 1, sig_id 2221036, type limit, track by_src, count 1, seconds 600
# 2221035 HTTP request excessive header repetition
threshold gen_id 1, sig_id 2221035, type limit, track by_src, count 1, seconds 600
# 2221014 HTTP missing Host header
threshold gen_id 1, sig_id 2221014, type limit, track by_src, count 1, seconds 600
# 2221010 HTTP unable to match response to request
threshold gen_id 1, sig_id 2221010, type limit, track by_src, count 1, seconds 600
# 2260000 Applayer mismatch protocol both directions
threshold gen_id 1, sig_id 2260000, type limit, track by_src, count 1, seconds 600
# 2260002 Applayer detect protocol only one direction
threshold gen_id 1, sig_id 2260002, type limit, track by_src, count 1, seconds 600

# --- ET INFO low-value chatter: benign SaaS/dev lookups, package-manager
#     egress, and routine TLS handshake failures. Keep 1/src/10min for context.
# 2029340 ET INFO TLS Handshake Failure
threshold gen_id 1, sig_id 2029340, type limit, track by_src, count 1, seconds 600
# 2049132 ET INFO Supabase dev-platform domain in DNS
threshold gen_id 1, sig_id 2049132, type limit, track by_src, count 1, seconds 600
# 2050130 ET INFO supabase.co in TLS SNI
threshold gen_id 1, sig_id 2050130, type limit, track by_src, count 1, seconds 600
# 2013504 ET INFO GNU/Linux APT User-Agent outbound
threshold gen_id 1, sig_id 2013504, type limit, track by_src, count 1, seconds 600

# --- DELIBERATELY NOT TUNED ---------------------------------------------------
# sig_id 2031502 "ET INFO Request to Hidden Environment File - Inbound" (106 hits,
#   1 src) is reconnaissance against /.env secrets — low Suricata class but real
#   attacker behavior. Left at FULL FIDELITY on purpose. Do not rate-limit/suppress.
